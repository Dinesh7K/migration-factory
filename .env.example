# Copy to .env (never commit .env)

# Runtimes: emulator|sqlserver  and  spark|duckdb
# spark = local PySpark (needs Java 17 or 21). duckdb = fast development mode, no Java.
LEGACY_MODE=emulator
NEW_MODE=spark

# LLM: ollama | openai | azure | offline
# ollama = free local model (run `ollama serve` and `ollama pull qwen2.5-coder` first)
LLM_PROVIDER=offline
LLM_TIMEOUT=120
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# SQL Server (docker compose)
MSSQL_SA_PASSWORD=MigrateGuard!2026
MSSQL_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;UID=sa;PWD=MigrateGuard!2026;TrustServerCertificate=yes

%macro portfolio_45(source=claims, cutoff=2020-01-01);
proc sort data=&source out=ordered_45;
by policy_id claim_date;
run;
data sasb_45;
merge ordered_45(in=has_claim) policies(in=has_policy);
by policy_id;
retain running_total prior_status;
if first.policy_id then do;
running_total=0;
prior_status='';
end;
if has_claim and has_policy and claim_date >= "&cutoff"d then do;
running_total + coalesce(paid_amount,0);
prior_status=status;
end;
if last.policy_id and has_claim then output;
array amounts[3] amount1-amount3;
do idx=1 to dim(amounts);
amounts[idx]=running_total/idx;
end;
drop idx;
run;
%portfolio_45(source=claims, cutoff=2021-01-01);
